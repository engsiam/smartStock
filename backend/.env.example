# Copy this file to `.env` and fill in real values. NEVER commit `.env`.

# ==========================================
# DATABASE CONFIGURATION (Local / Supabase)
# ==========================================
# 1. LOCAL DEVELOPMENT:
DATABASE_URL="postgresql://smartstock:CHANGE_ME@localhost:5432/smartstock?schema=public"
DIRECT_URL="postgresql://smartstock:CHANGE_ME@localhost:5432/smartstock?schema=public"
# Separate database used by integration tests (see scripts/setup-db.ts)
DATABASE_URL_TEST="postgresql://smartstock:CHANGE_ME@localhost:5432/smartstock_test?schema=public"

# 2. SUPABASE POSTGRESQL (Uncomment and paste your Supabase credentials when ready):
# Transaction Pooler (Port 6543) - Recommended for high-concurrency API runtime queries:
# DATABASE_URL="postgresql://postgres.[YOUR_PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"
# Direct Session Connection (Port 5432) - Required for Prisma schema migrations:
# DIRECT_URL="postgresql://postgres.[YOUR_PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require"

# ==========================================
# SUPABASE PROJECT CREDENTIALS (Optional)
# ==========================================
# Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# ==========================================
# SERVER & SECURITY
# ==========================================
PORT=3000
NODE_ENV=development
# Comma-separated list of allowed origins for browser requests
CORS_ORIGIN="http://localhost:5173"

# Must be at least 32 random characters. Generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="CHANGE_ME_generate_a_long_random_secret_value"
JWT_ACCESS_TTL="7d"
JWT_REFRESH_TTL="30d"

# Rate Limiting
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=300

# ==========================================
# AI ADVISOR (Gemini 2.5)
# ==========================================
# BACKEND-ONLY. Never expose this key to the frontend or commit it.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
GEMINI_TIMEOUT_MS=10000
