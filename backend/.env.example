# Copy this file to `.env` and fill in real values. NEVER commit `.env`.

# --- Database (PostgreSQL) ---
DATABASE_URL="postgresql://smartstock:CHANGE_ME@localhost:5432/smartstock?schema=public"
# Separate database used by integration tests (see scripts/setup-db.ts)
DATABASE_URL_TEST="postgresql://smartstock:CHANGE_ME@localhost:5432/smartstock_test?schema=public"

# --- Server ---
PORT=3000
NODE_ENV=development
# Comma-separated list of allowed origins for browser requests
CORS_ORIGIN="http://localhost:5173"

# --- Auth ---
# Must be at least 32 random characters. Generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="CHANGE_ME_generate_a_long_random_secret_value"
JWT_ACCESS_TTL="7d"
JWT_REFRESH_TTL="30d"

# --- Rate limiting ---
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=300

# --- AI advisor (optional — deterministic fallback is used when empty) ---
# BACKEND-ONLY. Never expose this key to the frontend or commit it.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
GEMINI_TIMEOUT_MS=10000
